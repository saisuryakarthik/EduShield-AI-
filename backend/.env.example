# EduShield AI — environment template.
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env. Only this example file belongs in version control.

# ---- App ---------------------------------------------------------
EDUSHIELD_ENV=development          # development | production
FLASK_DEBUG=0
EDUSHIELD_HOST=127.0.0.1
EDUSHIELD_PORT=5000
EDUSHIELD_BASE_URL=http://127.0.0.1:5000

# ---- Auth tokens -------------------------------------------------
# Lifetime of an issued JWT, in minutes.
EDUSHIELD_TOKEN_TTL_MINUTES=60

# ---- CORS / frontend ---------------------------------------------
# Comma-separated browser origins allowed to call this API.
# Defaults to the local frontend when unset.
EDUSHIELD_ALLOWED_ORIGINS=http://127.0.0.1:5002,http://localhost:5002

# ---- Cookies (frontend) ------------------------------------------
# Set to 1 to send session cookies only over HTTPS (production).
EDUSHIELD_COOKIE_SECURE=0

# ---- Secrets (generate long random values) -----------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
# Keys the OTP hashes. Required at startup.
EDUSHIELD_OTP_PEPPER=replace-with-a-long-random-pepper

# ---- Database ----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=replace-with-your-db-user
DB_PASSWORD=replace-with-your-db-password
DB_NAME=edushieldai

# ---- OTP Delivery (zero-cost demo support) -----------------------
# demo       = both channels use the local demo inbox (no real SMS/email)
# production = SMS via 2Factor, email via Brevo; credentials required
OTP_DELIVERY_MODE=demo

# 2Factor (production SMS provider)
TWOFACTOR_API_KEY=
# Optional approved Custom OTP template name (appended to the endpoint).
TWOFACTOR_TEMPLATE_NAME=
# or
# 2FACTOR_API_KEY=

# Brevo (production email provider; required when OTP_DELIVERY_MODE=production)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=EduShield AI

# ---- SMS (parent OTP) --------------------------------------------
# SMS is selected by OTP_DELIVERY_MODE above: 2Factor in production,
# the demo inbox in demo. Provider failures are reported, never replaced
# by a console/SMTP/Twilio fallback. No legacy SMS settings are used.
# This variable is retained only for older deployment scripts.
EDUSHIELD_SMS_PROVIDER=disabled

# ---- SIS import (Phase 1) ----------------------------------------
# Directory the importer reads students.csv / mentors.csv from by default.
SIS_IMPORT_DIR=backend/scripts/sample_data

# ---- Account activation (Phase 1) --------------------------------
# Email OTP rules for account activation. Same pattern as parent OTPs.
ACTIVATION_OTP_EXPIRY_MINUTES=5
ACTIVATION_MAX_ATTEMPTS=3
ACTIVATION_RESEND_COOLDOWN_SECONDS=60

# ---- Destructive real-DB tests (never production) ----------------
# The suites in backend/tests that use dbtest.py TRUNCATE every table.
# They are disabled unless BOTH of these are set and agree:
#   TEST_DATABASE_URL       full mysql:// URL of a dedicated disposable DB
#   EDUSHIELD_TEST_DB_NAME  the same database name, prefix edushield_test_
# The harness refuses edushield_test (preserved regression data) and
# edushieldai (live app). Example:
#   TEST_DATABASE_URL=mysql://user:pass@127.0.0.1:3306/edushield_test_isolated
#   EDUSHIELD_TEST_DB_NAME=edushield_test_isolated
TEST_DATABASE_URL=
EDUSHIELD_TEST_DB_NAME=
