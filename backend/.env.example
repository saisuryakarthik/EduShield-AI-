# EduShield AI — environment template.
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env. Only this example file belongs in version control.

# ---- App ---------------------------------------------------------
EDUSHIELD_ENV=development          # development | production
FLASK_DEBUG=0
EDUSHIELD_BASE_URL=http://127.0.0.1:5000

# ---- Auth tokens -------------------------------------------------
# Lifetime of an issued JWT, in minutes.
EDUSHIELD_TOKEN_TTL_MINUTES=60

# ---- CORS / frontend ---------------------------------------------
# Comma-separated browser origins allowed to call this API.
# Defaults to the local frontend when unset.
EDUSHIELD_ALLOWED_ORIGINS=http://127.0.0.1:5002,http://localhost:5002

# ---- Cookies (frontend) ------------------------------------------
# Set to 1 to send session cookies only over HTTPS (production).
EDUSHIELD_COOKIE_SECURE=0

# ---- Secrets (generate long random values) -----------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
# Keys the OTP hashes. Required at startup.
EDUSHIELD_OTP_PEPPER=replace-with-a-long-random-pepper

# ---- Database ----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=replace-with-your-db-user
DB_PASSWORD=replace-with-your-db-password
DB_NAME=edushieldai

# ---- Email (parent OTP email, mentor and decision notices) -------
EDUSHIELD_EMAIL=your-smtp-address@example.com
EDUSHIELD_EMAIL_PASSWORD=replace-with-app-password
EDUSHIELD_SMTP_HOST=smtp.gmail.com
EDUSHIELD_SMTP_PORT=587

# ---- SMS (parent OTP) --------------------------------------------
# twilio   = real delivery (production)
# console  = prints the code to the terminal (local development only,
#            refused when EDUSHIELD_ENV=production)
# disabled = no SMS; requests still work but the SMS code cannot be sent
EDUSHIELD_SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
